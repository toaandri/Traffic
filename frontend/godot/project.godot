config_version=5

[application]
config/name="Traffic — Laboratoire de mobilité"
config/icon="res://assets/traffic.svg"
boot_splash/show_image=false
run/main_scene="res://scenes/main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=820
window/size/min_width=1100
window/size/min_height=740
window/vsync/vsync_mode=0

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.08, 0.11, 0.16, 1)
